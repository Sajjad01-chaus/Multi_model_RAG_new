# Copy to .env and paste your key after the equals sign. Never use a VITE_ prefix for secrets.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Planned MVP configuration; implementation must load this root .env explicitly.
DATA_DIR=./data
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_DENSE_TOP_K=15
RETRIEVAL_KEYWORD_TOP_K=15
RETRIEVAL_CONTEXT_TOP_K=6
RETRIEVAL_RRF_K=60
VIDEO_MAX_SECONDS=120
VIDEO_MAX_FRAMES=6
